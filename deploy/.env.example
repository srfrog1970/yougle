# Copy this file to .env (Docker) or to /etc/pm-node/pm-node.env
# (systemd) and fill in both values from the app: Manage Mailbox ->
# "Set up your own node" -> Tap to reveal. See ../README.md for the full
# runbook. Both must be exactly 64 hex characters (32 bytes).
PM_NODE_MAILBOX_KEY=
PM_NODE_TRANSPORT_KEY=

# Where mailbox storage persists across restarts. Uncomment for the
# Docker path — docker-compose.yml already mounts a named volume at
# /data, so this just tells pm-node to actually use it. Leave commented
# to run in-memory only (today's default; data won't survive a restart).
# The systemd path (pm-node.service) sets this automatically via
# StateDirectory= — don't set it here for that path, since
# EnvironmentFile= is applied before the unit's own Environment=
# directive and would just be overridden anyway.
#PM_NODE_DATA_DIR=/data
